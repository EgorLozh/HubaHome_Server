APP_NAME=HubaHome_Server
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_KEY=dev-api-key

QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://192.168.0.109:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=128
OLLAMA_NUM_CTX=3072
OLLAMA_REQUEST_TIMEOUT_S=18

WHISPER_MODEL_NAME=small
WHISPER_MODELS_DIR=.models/whisper
WHISPER_AUTO_DOWNLOAD=true
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

PIPER_MODEL_NAME=ru_RU-irina-medium
PIPER_MODELS_DIR=.models/piper
PIPER_AUTO_DOWNLOAD=true
PIPER_USE_CUDA=true
PIPER_SPEAKER_ID=0

ENABLE_REAL_STT=true
ENABLE_REAL_TTS=true
ENABLE_REAL_WEB_SEARCH=true

METRICS_ENABLED=true

AGENT_MAX_STEPS_PER_TURN=3
AGENT_MAX_TOOL_CALLS_PER_TURN=2
STT_TIMEOUT_MS=20000
AGENT_TURN_TIMEOUT_MS=20000
TTS_TIMEOUT_MS=20000
KNOWLEDGE_COLLECTION_NAME=knowledge_notes
KNOWLEDGE_METADATA_PATH=.data/knowledge/metadata.json
